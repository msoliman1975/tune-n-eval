{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agritune.local/contracts/model-ref.schema.json",
  "title": "ModelRef",
  "description": "What Eval needs to reach a model. Written by the Train service for every base, run and export.",
  "type": "object",
  "required": ["id", "kind", "base", "chat_template"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "examples": ["run-0007-qwen8b-mango-v1", "base-qwen3-8b"] },
    "kind": { "enum": ["hf_base", "hf_adapter", "gguf", "ollama"] },
    "base": { "type": "string", "examples": ["unsloth/Qwen3-8B-unsloth-bnb-4bit"] },
    "uri": { "type": "string", "description": "Artifact path of the adapter or GGUF file; absent for hf_base." },
    "ollama_tag": { "type": "string", "examples": ["agritune/qwen8b-mango:v1"] },
    "chat_template": { "type": "string", "examples": ["qwen3"] },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": { "type": "string", "description": "DatasetRef as id@version.", "examples": ["mango-sft@v0.1"] },
        "preset": { "type": "string" },
        "mlflow_run_id": { "type": "string" },
        "parent": { "type": "string", "description": "ModelRef id this was exported from." }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace_id": { "type": "string", "default": "default" }
  }
}
